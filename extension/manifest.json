{
  "manifest_version": 3,
  "name": "SiteShot - Image Alt Generator",
  "version": "1.0.0",
  "description": "Scans the active page for images, generates descriptions using Gemini AI, and overlays them in-context.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content_style.css"]
    }
  ]
}
